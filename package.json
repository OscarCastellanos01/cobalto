{
  "name": "cobalto",
  "version": "0.1.0",
  "description": "Componentes UI editoriales para Tailwind CSS v4: tipografia monoespaciada, bordes finos y colores personalizables con variables CSS.",
  "keywords": [
    "tailwindcss",
    "tailwind",
    "ui",
    "components",
    "css",
    "design-system",
    "editorial",
    "monospace",
    "laravel",
    "blade"
  ],
  "homepage": "https://github.com/OscarCastellanos01/cobalto#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OscarCastellanos01/cobalto.git"
  },
  "bugs": {
    "url": "https://github.com/OscarCastellanos01/cobalto/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Oscar Castellanos (TruperMax)",
    "url": "https://trupermax.com"
  },
  "type": "module",
  "main": "./dist/cobalto.js",
  "module": "./dist/cobalto.js",
  "style": "./dist/cobalto.css",
  "unpkg": "./dist/cobalto.umd.js",
  "jsdelivr": "./dist/cobalto.umd.js",
  "exports": {
    ".": {
      "import": "./dist/cobalto.js",
      "default": "./dist/cobalto.js"
    },
    "./css": {
      "style": "./dist/cobalto.css",
      "default": "./dist/cobalto.css"
    },
    "./css/min": {
      "style": "./dist/cobalto.min.css",
      "default": "./dist/cobalto.min.css"
    },
    "./tailwind": {
      "style": "./src/cobalto.css",
      "default": "./src/cobalto.css"
    },
    "./tokens.css": {
      "style": "./src/tokens.css",
      "default": "./src/tokens.css"
    },
    "./components/*": "./src/js/components/*.js",
    "./core": "./src/js/core.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "npm run build:css && npm run build:js && npm run build:site",
    "build:css": "tailwindcss -i ./scripts/dist.css -o ./dist/cobalto.css --optimize && tailwindcss -i ./scripts/dist.css -o ./dist/cobalto.min.css --minify",
    "build:js": "node ./scripts/build-js.mjs",
    "build:site": "node ./scripts/i18n-sync.mjs --check && node ./scripts/build-docs.mjs && tailwindcss -i ./docs/src/site.css -o ./docs/assets/site.css --minify",
    "dev": "tailwindcss -i ./docs/src/site.css -o ./docs/assets/site.css --watch",
    "format": "prettier --write \"src/**/*.{css,js}\" \"scripts/**/*.{mjs,css}\" \"docs/src/**/*.{mjs,css}\" \"docs/js/*.js\"",
    "format:check": "prettier --check \"src/**/*.{css,js}\" \"scripts/**/*.{mjs,css}\" \"docs/src/**/*.{mjs,css}\" \"docs/js/*.js\"",
    "lint:style": "node ./scripts/lint-style.mjs",
    "test:contrast": "node ./scripts/check-contrast.mjs",
    "test:a11y": "node ./scripts/check-pages.mjs examples/landing.html docs/index.html docs/personalizacion.html --all-themes --mobile --no-shots",
    "test:smoke": "node ./scripts/smoke.mjs",
    "test": "npm run lint:style && npm run test:contrast && node ./scripts/i18n-sync.mjs --check && npm run test:smoke",
    "prepublishOnly": "npm run build && npm run lint:style && npm run test:contrast",
    "i18n:sync": "node ./scripts/i18n-sync.mjs",
    "test:i18n": "node ./scripts/check-i18n.mjs",
    "build:deploy": "npm run build && node ./scripts/build-deploy.mjs"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3"
  },
  "engines": {
    "node": ">=18"
  }
}
